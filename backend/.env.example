# Copy to .env for local (non-docker) backend development.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://nexamarket:change_me_dev_password@localhost:5432/nexamarket
PGPOOL_MAX=10
# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=2h
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
