# Copy this file to .env and fill in real values for local docker-compose use.
# Never commit a real .env file.

# ---------- PostgreSQL ----------
POSTGRES_USER=nexamarket
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=nexamarket
POSTGRES_PORT=5432

# ---------- Backend ----------
NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://nexamarket:change_me_dev_password@postgres:5432/nexamarket
PGPOOL_MAX=10
# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=2h
CORS_ORIGIN=http://localhost:8080
LOG_LEVEL=info
BACKEND_PORT=4000

# ---------- Frontend ----------
# Base path the browser uses to call the API. Nginx proxies this to BACKEND_UPSTREAM.
VITE_API_URL=/api
# host:port of the backend service, used by the Nginx reverse proxy inside the frontend container
BACKEND_UPSTREAM=backend:4000
FRONTEND_PORT=8080
